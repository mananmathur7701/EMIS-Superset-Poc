# Copy to .env and fill in. It is not committed; the backend and superset/local/env.sh read it.

# Everything runs on this machine (no Docker): the frontend on http://localhost:3000 (npm run dev),
# the backend on http://localhost:8081 (IntelliJ or mvn spring-boot:run), Superset on
# http://localhost:8088 (superset/local/start.sh, which reads this file through superset/local/env.sh).
SUPERSET_PORT=8088

# The ONE database used by everything: an existing Postgres database on this machine,
# prepared once with database/setup.sql (see README). The backend logs in as DB_USERNAME
# (postgres by default, see backend/src/main/resources/application.yml) with DB_PASSWORD below.
EMIS_DB_HOST=127.0.0.1
EMIS_DB_PORT=5432
EMIS_DB_NAME=emis_superset_app

# Password of the Postgres login the backend uses (DB_USERNAME, postgres by default).
# The backend reads this file itself (spring.config.import in application.yml).
DB_PASSWORD=

# Passwords of the two logins database/setup.sql creates. Use long random values.
EMIS_READER_PASSWORD=
SUPERSET_DB_PASSWORD=

# Log users out after this long without activity (e.g. 30m, 2h, 90s).
SESSION_IDLE_TIMEOUT=30m
# Show the demo "switch account" dropdown after login. Set to false for anything real.
DEMO_SWITCH_ENABLED=true

# Superset secrets. Change these for anything beyond a laptop demo. Keep SUPERSET_SECRET_KEY
# stable once set: it also encrypts the database passwords Superset stores.
SUPERSET_SECRET_KEY=dev-only-superset-secret-change-me-0123456789
SUPERSET_GUEST_TOKEN_SECRET=dev-only-guest-token-secret-change-me
# Shared by the backend and Superset: signs the CPU analyst in to the builder automatically.
# The backend reads it from this file too, so both always use the same value.
EMIS_SSO_SECRET=dev-only-sso-secret-change-me-0123456789
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@emis.local
